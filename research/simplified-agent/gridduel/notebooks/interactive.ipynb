# Batch evaluation with parallel runner
from runner.parallel_runner import run_matches, MatchSpec

specs = [
    MatchSpec(policy0='random', policy1='rule', episodes=1, config={'seed': 100 + i})
    for i in range(16)
]
results = run_matches(specs, n_workers=4, seed=123)

wins = sum(r['wins0'] for r in results)
losses = sum(r['wins1'] for r in results)
draws = sum(r['draws'] for r in results)
print({'wins': wins, 'losses': losses, 'draws': draws})
# Interactive controls with ipywidgets
import ipywidgets as widgets
from IPython.display import display, clear_output
import matplotlib.pyplot as plt
import numpy as np

from gridduel_env.env import GridDuelEnv
from gridduel_env.policies import RandomPolicy, RulePolicy, HumanPolicy

policy_options = {
    "Random": RandomPolicy,
    "Rule": RulePolicy,
}

H = widgets.IntSlider(value=7, min=5, max=15, step=1, description='H')
W = widgets.IntSlider(value=7, min=5, max=15, step=1, description='W')
partial = widgets.IntSlider(value=0, min=0, max=3, step=1, description='Partial r')
cooldown = widgets.IntSlider(value=0, min=0, max=10, step=1, description='Cooldown')
player0 = widgets.Dropdown(options=list(policy_options.keys()), value='Random', description='P0')
player1 = widgets.Dropdown(options=list(policy_options.keys()), value='Rule', description='P1')
run_btn = widgets.Button(description='Run Episode')
output = widgets.Output()


def run_episode(_):
    output.clear_output()
    r = None if partial.value == 0 else partial.value
    cd = None if cooldown.value == 0 else cooldown.value
    env = GridDuelEnv(H=H.value, W=W.value, partial_obs=r, cooldown=cd, seed=42)
    pol0 = policy_options[player0.value]()
    pol1 = policy_options[player1.value]()
    (obs0, obs1), _ = env.reset()
    positions0 = []

    with output:
        while True:
            a0 = pol0.act(obs0)
            a1 = pol1.act(obs1)
            (obs0, obs1), (r0, r1), done, info = env.step_both(a0, a1)
            positions0.append(tuple(info['positions'][0]))
            clear_output(wait=True)
            print(env.render('ascii'))
            if done:
                print('Rewards:', r0, r1)
                break

        # Plot heatmap of P0 positions visited
        grid = np.zeros((env.height, env.width))
        for y, x in positions0:
            if y is not None:
                grid[y, x] += 1
        fig, ax = plt.subplots(figsize=(4,4))
        ax.imshow(grid, cmap='magma')
        ax.set_title('P0 visitation heatmap')
        plt.show()

run_btn.on_click(run_episode)

controls = widgets.VBox([widgets.HBox([H, W, partial, cooldown]), widgets.HBox([player0, player1, run_btn])])
display(controls, output)
# Single episode demo vs RandomPolicy
from gridduel_env.env import GridDuelEnv
from gridduel_env.policies import RandomPolicy, RulePolicy

env = GridDuelEnv(H=7, W=7, partial_obs=None, seed=123)
pol0 = RandomPolicy()
pol1 = RulePolicy()

(obs0, obs1), _ = env.reset()
frames = []
while True:
    a0 = pol0.act(obs0)
    a1 = pol1.act(obs1)
    (obs0, obs1), (r0, r1), done, info = env.step_both(a0, a1)
    frames.append(env.render("ascii"))
    if done:
        break

print("\n\n".join(frames))
print("Rewards:", r0, r1)
# GridDuel Interactive Playground

This notebook demonstrates the GridDuel RL playground.

Setup:

- Create and activate a virtualenv
- Install requirements from `requirements.txt`

```bash
python -m venv .venv
. .venv/bin/activate
pip install -r requirements.txt
```

Tip: For `TorchModelPolicy`, install PyTorch separately.
